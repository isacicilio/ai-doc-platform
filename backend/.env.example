# App
DEBUG=true

# Banco
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aidocs

# Providers
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# Chaves
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2
EMBEDDING_DIM=1536

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4