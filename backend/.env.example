# Copie este arquivo para ".env" e ajuste os valores.
# O .env NUNCA deve ir pro GitHub (ja esta no .gitignore).

# Provedores: ollama | claude | openai
LLM_PROVIDER=ollama
# Provedores: local | openai
EMBEDDING_PROVIDER=local

# Modelo local do Ollama
OLLAMA_MODEL=llama3.1

# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docintel

# Chaves (so se usar provedor pago)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Parametros do RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
